<?xml version="1.0" encoding="utf-8"?>
<!-- Mini (3x1): previous / play-pause / next.
     Filled in by widget/WidgetRenderer.kt; the text here is what the
     launcher's widget picker shows (previewLayout). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">
    <LinearLayout
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="UselessParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="4dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/widget_ic_previous"
            android:tint="@color/widget_text"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="44dp"
                android:layout_gravity="center"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/widget_ic_play"
                android:tint="@color/widget_on_play"
                android:background="@drawable/widget_play_background"
                android:contentDescription="@string/play" />
        </FrameLayout>
        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/widget_ic_next"
            android:tint="@color/widget_text"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next" />
    </LinearLayout>
</FrameLayout>
