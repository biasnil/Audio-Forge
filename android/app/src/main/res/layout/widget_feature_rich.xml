<?xml version="1.0" encoding="utf-8"?>
<!-- Feature-Rich (4x3): Practical plus the lyric line and the next two songs.
     Filled in by widget/WidgetRenderer.kt; the text here is what the
     launcher's widget picker shows (previewLayout). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/widget_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/auto_nothing_playing"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_lyric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Chronometer
                android:id="@+id/widget_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
            <ProgressBar
                android:id="@+id/widget_progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/widget_text"
                android:progressBackgroundTint="@color/widget_text_secondary" />
            <TextView
                android:id="@+id/widget_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_shuffle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/widget_ic_shuffle"
                android:tint="@color/widget_text"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/shuffle" />
            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/widget_ic_previous"
                android:tint="@color/widget_text"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="44dp"
                    android:layout_gravity="center"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/widget_ic_play"
                    android:tint="@color/widget_on_play"
                    android:background="@drawable/widget_play_background"
                    android:contentDescription="@string/play" />
            </FrameLayout>
            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/widget_ic_next"
                android:tint="@color/widget_text"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next" />
            <ImageView
                android:id="@+id/widget_love"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/widget_ic_heart_outline"
                android:tint="@color/widget_text"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/love" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_up_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/up_next"
            android:textAllCaps="true"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_next1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_next2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
