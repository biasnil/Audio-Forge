<?xml version="1.0" encoding="utf-8"?>
<!-- Stylish (4x2): the cover fills the left half, controls on the right.
     Filled in by widget/WidgetRenderer.kt; the text here is what the
     launcher's widget picker shows (previewLayout). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">
    <LinearLayout
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="UselessParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <!-- Without a cover, a plain panel with the note (a placeholder image would be cropped here). -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/widget_placeholder">
            <ImageView
                android:id="@+id/widget_cover_note"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_music_note"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/auto_nothing_playing"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/widget_ic_previous"
                    android:tint="@color/widget_text"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/previous" />
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/widget_play"
                        android:layout_width="44dp"
                        android:layout_gravity="center"
                        android:layout_height="44dp"
                        android:padding="10dp"
                        android:src="@drawable/widget_ic_play"
                        android:tint="@color/widget_on_play"
                        android:background="@drawable/widget_play_background"
                        android:contentDescription="@string/play" />
                </FrameLayout>
                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/widget_ic_next"
                    android:tint="@color/widget_text"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
