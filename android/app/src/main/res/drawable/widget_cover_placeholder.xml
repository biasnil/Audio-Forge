<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when the song has no cover, and in the widget picker. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_placeholder" />
            <size android:width="96dp" android:height="96dp" />
        </shape>
    </item>
    <item
        android:width="40dp"
        android:height="40dp"
        android:drawable="@drawable/widget_ic_music_note"
        android:gravity="center" />
</layer-list>
