<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The phone's music library (MediaStore). Added folders don't need it:
         the folder picker grants access to each one. Android 13+ has a
         music-only permission; Android 12 uses the older storage one
         (see audioPermission in LibraryRepository.kt). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Lyrics lookups (LRCLIB, Musixmatch), podcasts, internet radio. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Background playback: a media-playback foreground service, and
         keeping the CPU awake while playing with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- LiteRT asks for a data-sync foreground service to download models as
         Play AI packs. The genre model ships inside the app (and that part of
         LiteRT is left out, see build.gradle.kts), so drop it: Play would
         otherwise want a foreground service declaration for a feature the
         app doesn't have. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:node="remove" />
    <!-- Bit-perfect USB DAC output (Android 14+ preferred mixer attributes);
         a normal permission, granted without asking. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".AudioForgeApplication"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioForge">

        <!-- singleTop: tapping the playback notification returns to the
             running app instead of opening a second copy. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Home-screen widgets: one provider per style, so each style is its
             own entry in the launcher's widget picker (see widget/). -->
        <receiver
            android:name=".widget.MiniWidget"
            android:exported="false"
            android:label="@string/widget_style_mini">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_mini" />
        </receiver>
        <receiver
            android:name=".widget.LiteWidget"
            android:exported="false"
            android:label="@string/widget_style_lite">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_lite" />
        </receiver>
        <receiver
            android:name=".widget.ClassicWidget"
            android:exported="false"
            android:label="@string/widget_style_classic">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_classic" />
        </receiver>
        <receiver
            android:name=".widget.SimpleWidget"
            android:exported="false"
            android:label="@string/widget_style_simple">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_simple" />
        </receiver>
        <receiver
            android:name=".widget.StandardWidget"
            android:exported="false"
            android:label="@string/widget_style_standard">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_standard" />
        </receiver>
        <receiver
            android:name=".widget.StylishWidget"
            android:exported="false"
            android:label="@string/widget_style_stylish">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_stylish" />
        </receiver>
        <receiver
            android:name=".widget.PracticalWidget"
            android:exported="false"
            android:label="@string/widget_style_practical">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_practical" />
        </receiver>
        <receiver
            android:name=".widget.FeatureRichWidget"
            android:exported="false"
            android:label="@string/widget_style_feature_rich">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_feature_rich" />
        </receiver>
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />
        <!-- A widget's own settings (its background), from the home screen. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AudioForge.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Shares images the app makes (Listening stats' Year in Review) with
             the app the user picks; see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Android Auto: AudioForge shows up as a media app in the car. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>
